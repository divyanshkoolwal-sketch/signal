# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=4000

# Coinbase Advanced Trade WebSocket is public — no API key needed for live market data.
# Keys below are only required for live order execution (optional).
LIQUID_API_KEY=your_api_key_here
LIQUID_API_SECRET=your_api_secret_here

# CORS — set to your frontend origin
CORS_ORIGIN=http://localhost:3000

# Set to true to force synthetic data (for offline demos)
FORCE_SIMULATION=false
